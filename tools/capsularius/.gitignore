# Local Capsularius desktop runtime and machine-specific data.
Capsularius Desktop/
_capsularius-brand-staging/
_capsularius-brand-package/

# Keep the folder itself in the repository; ignore all local state inside it.
.capsularius-data/*
!.capsularius-data/.gitkeep

